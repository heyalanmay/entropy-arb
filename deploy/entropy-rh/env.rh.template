# =============================================================================
# entropy-arb 密钥 —— 交易对：Entropy(io) × Lighter Robinhood 链
#
# 复制位置：~/entropy-arb/.env  然后填入真实值（install.sh 会备份旧文件）
# 切勿提交到 git。填完后执行：chmod 600 .env
# =============================================================================
#
# ⚠️ 填之前先读 PREP.md 第 1 层 —— 资金隔离比任何参数都重要
#
# 已查实的权限边界：
#   · HL agent 钱包   不能提现（协议级禁止），但【花的是你主账户的余额】
#                     → config 里的 max_position_usd 只是软限制，挡不住填错和 bug
#                     → 必须给这套策略开独立的、只放小额资金的 HL 账户
#   · Lighter API key 能提现，但只能提到创建该账户的 L1 地址（协议级限制）
#                     → 真实风险是「被亏掉」而不是「被转走」，用子账户隔离
# =============================================================================

# ===== Entropy —— Hyperliquid（必填） =====
# 在 https://app.hyperliquid.xyz/API 创建 API(agent) 钱包：
# 这里填 agent 钱包的私钥，下面填你的主账户地址。
# 请用【独立小账户】的主账户地址，不要用你存放主要资金的那个账户。
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=

# ===== 对冲腿 lighter-rh（必填） =====
# ⚠️ 关键：Lighter 主网(lighter) 与 Robinhood 链(lighter-rh) 是两套独立账户和密钥。
# 这里必须填在 https://robinhoodchain.lighter.xyz 上注册的那一套，
# 填错会报 "API key check failed"。
# chain_id = 466324（区别于主网 304）。
# RH 链计价货币是 USDG（不是 USDC）—— 充进去的 USDC 会显示成 USDG，这是正常的。
#
# 建议用子账户；apiKeyIndex 用 4~254（Lighter 官方保留 0~3 给自家网页端，
# 占用会让你在网页上被踢下线）。
#
# 拿到密钥后，用这两条命令验证（不需要下单，纯只读）：
#   1) 用你的以太坊地址查 account_index
#      curl -sS --get "https://api.rh.lighter.xyz/api/v1/accountsByL1Address" \
#           --data-urlencode "l1_address=0x你的地址"
#   2) 确认 key 已在该子账户上注册成功（返回 "code":200 即正确）
#      curl -sS --get "https://api.rh.lighter.xyz/api/v1/apikeys" \
#           --data-urlencode "account_index=上面查到的" \
#           --data-urlencode "api_key_index=你选的index"
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# =============================================================================
# 资金看门狗 guard.py 的红线（可选，留空则用默认值）
#
# guard.py 跑在 bot 进程之外，只调公开只读接口（不需要任何私钥），
# 独立于 bot 核对账户层的持仓和权益。config.yaml 里没有日亏损熔断、
# 也没有净敞口上限，这一层由 guard 来补。
#
# 触发红线时 guard 会【停掉 bot 进程、停止继续开仓】，但不会自动平仓
# —— 自动平仓需要持有私钥，会摧毁它「连单都下不了」的安全优势。
# 平仓由你决定。
# =============================================================================

# 交易品种（guard 与 bot 共用，避免两边不一致）
SYMBOL=SNDK

# ⚠️ 2026-09-04 按 $100 总资金重算（原值按 $600 cap 配的，不匹配会形同虚设）
#
# 资金分配：io dex $50 + Lighter RH $50
# config 的 max_position_usd = 150（每腿）
#
# 单腿名义上限。略高于 config 的 max_position_usd，留出同步滞后余量
GUARD_MAX_LEG_USD=200

# 净敞口上限 —— 最该盯的一项。超过说明一腿成交另一腿没跟上，正在单边裸奔
# 取单笔 max_order_notional_usd(30) 的 1.5 倍，即「一笔半没对冲上」就该报警
GUARD_MAX_NET_USD=45

# 单日亏损红线，触发即停机。约占总资金 10%
GUARD_MAX_DAY_LOSS_USD=10

# 账户权益下限（两边合计）
GUARD_MIN_EQUITY_USD=50

# CRIT 时推送通知的地址（企业微信/钉钉/自建中转均可，留空则不推送）
GUARD_WEBHOOK_URL=
